# Copy this file to .env and fill in what you have.
# Nothing here is required to collect public stats.

# Open Cloud analytics: revenue, DAU, retention, playtime, funnels.
# Create at https://create.roblox.com/dashboard/credentials
#   Add API system: "universe-analytics"
#   Operation: universe.analytics:read
#   Attach YOUR experience to the key, and set an IP allowlist of 0.0.0.0/0
#   (or your server IP) or every call returns 403.
ROBLOX_API_KEY=

# Discord alerts. Server settings -> Integrations -> Webhooks -> New webhook.
DISCORD_WEBHOOK_URL=

# Optional override for config.json game.placeId
ROBLOX_PLACE_ID=
